<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>AstralParty_CharacterSelect</AssemblyName>
    <Version>1.3.0</Version>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Setup/**/*.cs" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/interop/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/interop/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/interop/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/interop/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/interop/Unity.Addressables.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/interop/Unity.ResourceManager.dll" Private="false" />
  </ItemGroup>
  <Target Name="ValidateGameDirectory" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameDir)' == '' Or !Exists('$(GameDir)/BepInEx/core/BepInEx.Unity.IL2CPP.dll')"
           Text="Set GameDir to the Astral Party folder containing BepInEx core and interop." />
    <Error Condition="!Exists('$(GameDir)/BepInEx/interop/UnityEngine.CoreModule.dll')"
           Text="Launch Astral Party with BepInEx once to generate the interop assemblies." />
  </Target>
</Project>
